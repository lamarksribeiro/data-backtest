strategy "Late Cheap Flip V1" {
  // Três teses de virada barata no mesmo harness (hold-to-settlement).
  // entryMode: 1=pre_flip (azarão + momentum ao PTB)
  //            2=post_flip (favorito pós-cruzamento + edge físico) — estilo SBRI terminal
  //            3=late_surprise (τ curto, favorito físico ainda barato)

  param walletSize = 100
  param entryBudget = 10
  param minShares = 1
  param entryMode = 2

  param minSecondsLeft = 15
  param maxSecondsLeft = 60

  param maxSecsSinceFlip = 8
  param minFlipsInWindow = 1

  param minDistAbs = 8
  param maxDistAbs = 80
  param minEdge = 0.08
  param volStepSecs = 30

  param momLookbackSecs = 5
  param minMomAbs = 3

  param minAsk = 0.05
  param maxAsk = 0.52
  param maxSpread = 0.04
  param minOddsSum = 0.96
  param maxOddsSum = 1.06

  param entrySlippageMax = 0.02
  param minLiquidityRatio = 0.60

  onEventStart(event) {
    state.entered = false
  }

  onTick(tick, event) {
    if (!state.entered) {
      let secsLeft = time.secondsUntil(event.end, tick.ts)
      if (secsLeft >= params.minSecondsLeft && secsLeft <= params.maxSecondsLeft) {
        let btc = tick.underlyingPrice
        let ptb = event.priceToBeat
        let dist = math.abs(btc - ptb)
        if (dist >= params.minDistAbs && dist <= params.maxDistAbs) {
          let fav = market.sideFromPrice(btc, ptb)
          let dog = prices.oppositeSide(fav)
          let flips = signals.ptbFlipCount(samples, params.maxSecsSinceFlip)

          let upAsk = book.ask("UP", tick)
          let downAsk = book.ask("DOWN", tick)
          let oddsSum = upAsk + downAsk

          if (oddsSum >= params.minOddsSum && oddsSum <= params.maxOddsSum) {
            let u1 = signals.underlyingAgo(samples, params.volStepSecs)
            let u2 = signals.underlyingAgo(samples, params.volStepSecs * 2)
            let u3 = signals.underlyingAgo(samples, params.volStepSecs * 3)
            let momAgo = signals.underlyingAgo(samples, params.momLookbackSecs)

            if (u1 && u2 && u3 && momAgo) {
              let d1 = btc - u1
              let d2 = u1 - u2
              let d3 = u2 - u3
              let meanSq = (d1 * d1 + d2 * d2 + d3 * d3) / (3 * params.volStepSecs)
              let sigmaPs = math.sqrt(meanSq)
              let momDelta = btc - momAgo
              let momAbs = math.abs(momDelta)

              if (sigmaPs > 0 && secsLeft > 0) {
                let z = dist / (sigmaPs * math.sqrt(secsLeft))
                let pPhysFav = math.normalCdf(z)

                // --- Mode 1: pre_flip — azarão barato, momentum em direção ao PTB, sem flip recente ---
                if (params.entryMode == 1) {
                  if (flips < 1) {
                    let towardPtb = (btc >= ptb && momDelta < 0) || (btc < ptb && momDelta > 0)
                    if (towardPtb && momAbs >= params.minMomAbs) {
                      let ask = book.ask(dog, tick)
                      let bid = book.bid(dog, tick)
                      if (ask >= params.minAsk && ask <= params.maxAsk) {
                        let spread = ask - bid
                        if (spread <= params.maxSpread) {
                          let pPhysDog = 1.0 - pPhysFav
                          let edge = pPhysDog - ask
                          if (edge >= params.minEdge || pPhysDog >= 0.35) {
                            let maxPrice = ask + params.entrySlippageMax
                            let budget = math.min(params.entryBudget, params.walletSize + runState.totalPnl)
                            let bought = enter(dog, {
                              price: ask,
                              maxPrice: maxPrice,
                              budget: budget,
                              minShares: params.minShares,
                              minLiquidityRatio: params.minLiquidityRatio,
                              tick: tick,
                              reason: "lcf_pre_flip"
                            })
                            if (bought) {
                              state.entered = true
                              mark("lcf_entry", {
                                mode: 1,
                                side: dog,
                                ask: ask,
                                edge: edge,
                                dist: dist,
                                mom: momDelta,
                                flips: flips
                              })
                            }
                          }
                        }
                      }
                    }
                  }
                }

                // --- Mode 2: post_flip — novo favorito com desconto vs P_phys ---
                if (params.entryMode == 2) {
                  if (flips >= params.minFlipsInWindow) {
                    let ask = book.ask(fav, tick)
                    let bid = book.bid(fav, tick)
                    if (ask >= params.minAsk && ask <= params.maxAsk) {
                      let spread = ask - bid
                      if (spread <= params.maxSpread) {
                        let edge = pPhysFav - ask
                        if (edge >= params.minEdge) {
                          let maxPrice = ask + params.entrySlippageMax
                          let budget = math.min(params.entryBudget, params.walletSize + runState.totalPnl)
                          let bought = enter(fav, {
                            price: ask,
                            maxPrice: maxPrice,
                            budget: budget,
                            minShares: params.minShares,
                            minLiquidityRatio: params.minLiquidityRatio,
                            tick: tick,
                            reason: "lcf_post_flip"
                          })
                          if (bought) {
                            state.entered = true
                              mark("lcf_entry", {
                                mode: 2,
                                side: fav,
                              ask: ask,
                              edge: edge,
                              dist: dist,
                              flips: flips
                            })
                          }
                        }
                      }
                    }
                  }
                }

                // --- Mode 3: late_surprise — favorito físico ainda barato no fim ---
                if (params.entryMode == 3) {
                  let ask = book.ask(fav, tick)
                  let bid = book.bid(fav, tick)
                  if (ask >= params.minAsk && ask <= params.maxAsk) {
                    let spread = ask - bid
                    if (spread <= params.maxSpread) {
                      let edge = pPhysFav - ask
                      if (edge >= params.minEdge) {
                        let maxPrice = ask + params.entrySlippageMax
                        let budget = math.min(params.entryBudget, params.walletSize + runState.totalPnl)
                        let bought = enter(fav, {
                          price: ask,
                          maxPrice: maxPrice,
                          budget: budget,
                          minShares: params.minShares,
                          minLiquidityRatio: params.minLiquidityRatio,
                          tick: tick,
                          reason: "lcf_late_surprise"
                        })
                        if (bought) {
                          state.entered = true
                          mark("lcf_entry", {
                            mode: 3,
                            side: fav,
                            ask: ask,
                            edge: edge,
                            dist: dist,
                            secsLeft: secsLeft
                          })
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  onEventEnd(event) {
  }
}
