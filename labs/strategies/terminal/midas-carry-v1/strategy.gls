strategy "MIDAS Carry V1" {
  // Núcleo Terminal Favorite Carry (envelope V7 campeão) com três mecanismos novos:
  // 1) Sigma sizing — orçamento por entrada escalado pelo z-score físico
  //    z = |spot-PTB| / (sigma_ps * sqrt(tau)), onde sigma_ps é a vol realizada
  //    por sqrt(segundo) aproximada do desvio-padrão de níveis (divisor ~ sqrt(T/3)).
  // 2) Scoop — entrada complementar no favorito quando ask < minAsk (bolsão convexo:
  //    vencedor quase certo precificado barato) com z mínimo alto.
  // 3) Danger exit contínuo — saída defensiva de 8s até o piso quando o colchão
  //    normalizado z cai abaixo de um limiar (substitui o gatilho de 1s da V7).

  param walletSize = 100
  param entryBudget = 10
  param minShares = 1
  param entrySlippageMax = 0.02
  param minLiquidityRatio = 0.60
  // Execução honesta (runtime): payout do vencedor no settlement.
  // Live Polymarket liquida ~0.995; 1.0 = lab otimista legado.
  // Não entra na lógica de decisão — só no PnL do simulador.
  param settleWinnerPrice = 1

  // Envelope terminal (idêntico à TFC V7 campeã)
  param minSecondsLeft = 5
  param maxSecondsLeft = 30
  param maxDistAbs = 20
  param minAsk = 0.55
  param maxAsk = 0.82
  param maxSpread = 0.03
  param minOddsSum = 0.98
  param maxOddsSum = 1.06

  // Spot velocity guard
  param velocityLookbackSecs = 5
  param maxAdverseSpotChange = 8.0

  // OBI gate
  param minObi = 0.0
  param obiLevels = 5

  // Sigma sizing
  param sigmaSizingEnabled = true
  param sigmaLookbackSecs = 90
  param sigmaDivisor = 5.48
  param zT1 = 0.5
  param zT2 = 1.0
  param zT3 = 2.5
  param zT4 = 4.0
  param wZ0 = 0.4
  param wZ1 = 0.7
  param wZ2 = 1.0
  param wZ3 = 1.4
  param wZ4 = 1.8

  // Scoop — favorito barato com z alto (fora do envelope TFC)
  param scoopEnabled = true
  param scoopMinZ = 1.5
  param scoopMinAsk = 0.10
  param scoopMaxAsk = 0.55
  param scoopMaxSpread = 0.05
  param scoopMaxDistAbs = 80
  param scoopMinSecondsLeft = 5
  param scoopMaxSecondsLeft = 30
  param scoopBudgetFactor = 1.0
  param scoopMinOddsSum = 0.90
  param scoopMaxOddsSum = 1.10

  // Late flip exit/reverse (V7)
  param stopMinBid = 0.05
  param lateFlipExitEnabled = true
  param lateFlipExitSec = 8
  param lateFlipExitCrossDist = 0
  param lateFlipMinSec = 4
  // Confirmação de book no gatilho de late flip (1.0 = off, comportamento legado).
  // Só age se o bid próprio já caiu abaixo do teto — o cruzamento físico sozinho
  // dispara em whipsaw; exigir que o book concorde corta o falso alarme.
  // Lab anti-flip 2026-07-27: lead+bid<0.40 rende +$302 sobre lead puro em 91d.
  param lateFlipExitMaxBid = 1.0
  param lateFlipReverseEnabled = true
  param lateFlipReverseMaxAsk = 0.95
  param lateFlipReverseMinAsk = 0.0
  // Fraction of entry budget used when reversing (1.0 = full size; 0.5 = half)
  param lateFlipReverseBudgetFactor = 1.0

  // Danger exit: modo V7 (piso) e modo contínuo z-based
  param dangerExitEnabled = true
  param dangerExitK = 0.3
  param dangerExitFloorSec = 4
  param dangerContinuousEnabled = false
  param dangerContinuousStartSec = 8
  param dangerContinuousMinZ = 0.25

  // Early-warning exit: sai antes da janela de late flip quando o ask do lado
  // oposto reprecifica acima do gatilho (mercado confirmando a virada).
  param earlyWarnEnabled = false
  param earlyWarnOppAsk = 0.45
  param earlyWarnStartSec = 20
  param earlyWarnEndSec = 8
  param earlyWarnOnlyIfLosing = true

  // Book collapse: sai quando o bid próprio desaba vs preço médio de entrada
  // mesmo com spot ainda "a favor" (divergência book×spot do caso live 2026-07-25).
  param bookCollapseEnabled = false
  param bookCollapseBidRatio = 0.70
  param bookCollapseAbsBid = 0.0
  param bookCollapseStartSec = 30
  param bookCollapseEndSec = 4
  param bookCollapseRequireSpotWinning = true

  // Odds shock: detecta o X-cross abrupto UP/DOWN (ask do oposto sobe rápido e/ou
  // ask próprio colapsa) — padrão da imagem de virada no final do evento.
  // Diferente do earlyWarn (nível estático): exige Δask no lookback (velocidade).
  // oddsShockPartialPct: 0 = exit total; 0.5 = vende 50% e mantém resto.
  // oddsShockReverseEnabled: tenta reverse no oposto (como lateFlip) em vez de só sair.
  param oddsShockEnabled = false
  param oddsShockStartSec = 20
  param oddsShockEndSec = 3
  param oddsShockLookbackSec = 2
  param oddsShockOppAskDelta = 0.15
  param oddsShockOwnAskDelta = 0.15
  param oddsShockMinOppAsk = 0.40
  param oddsShockOnlyIfLosing = false
  param oddsShockPartialPct = 0.0
  param oddsShockReverseEnabled = false
  // Só age se ainda há o que salvar: exige bid >= ratio * avgEntry (0 = off).
  // Hipótese: o exit-no-choque só tem valor antes do colapso completo do bid.
  param oddsShockMinBidRatio = 0.0

  // Gate de z mínimo na entrada core (0 = desativado)
  param minEntryZ = 0.0

  // Odds-velocity entry gate: bloqueia ENTRADA quando o book já está
  // reprecificando rápido (oppAsk sobe e/ou ask do favorito cai no lookback).
  // Hipótese: atacar o padrão X-cross antes de entrar, sem whipsaw de exit.
  // Condicionais (lab 2026-07-26 cf): mode 0=vel só; 1=AND; 2=OR dos filtros ativos.
  param oddsVelGateEnabled = false
  param oddsVelLookbackSec = 2
  param oddsVelMaxDelta = 0.12
  param oddsVelCondMode = 0
  param oddsVelCondAskMax = 0.0
  param oddsVelCondDistMin = 0.0
  param oddsVelCondMinSecs = 0.0
  // Ação ao bater vel+cond: block (default) ou reduzir tamanho (sizeFactor < 1, blockOnHit=false).
  param oddsVelBlockOnHit = true
  param oddsVelSizeFactor = 1.0

  // Tier de orçamento para favorito caro (carry de alta certeza, fee baixa)
  param tierAskThreshold = 0.82
  param tierAskBudgetFactor = 1.0
  // Gate de colchão físico só para o tier: favorito caro (ask >= tierAskThreshold)
  // exige z >= tierMinZ (0 = desativado). Favorito barato não é afetado.
  // Motivação: taxonomia de losses — os piores trades são entradas 0.82-0.95
  // com dist/z fraco que viram no fim (breakeven WR >= 90% não tolera chop).
  param tierMinZ = 0.0
  // Gate de distância absoluta no tier (0 = off). Diferente de tierMinZ: não
  // depende de σ (que explode z em vol baixa). Live 24–26/07: wipeouts high-ask
  // com |spot−PTB| frágil (~1–8) que tierMinZ deixaria passar.
  param tierMinDistAbs = 0.0

  // Teto de perda em dólar por entrada (0 = off). Em binário settle≈0, budget≈maxLoss.
  // Corta a cauda do tier 2x (live: losses −$2.5…−$2.7 com qty 3 @ 0.86–0.92).
  param maxLossUsd = 0.0

  // Cushion Decay Exit (EPS): sai quando o colchão signedDistance some ainda com
  // bid salvável — antes da janela late-flip de 8s. Diferente de bookCollapse
  // (bid ratio com spot ainda a favor) e de earlyWarn (nível estático de oppAsk).
  param cushionDecayEnabled = false
  param cushionDecayStartSec = 20
  param cushionDecayEndSec = 4
  param cushionDecayMinDist = 0.0
  param cushionDecayMinBidRatio = 0.55

  // Equity scale — orçamento proporcional à banca corrente (compound opcional)
  param equityScaleEnabled = false
  param equityScalePct = 0.10
  param maxEntryBudget = 30

  // Circuit breakers de dia (proteção que não depende de fill em book fino):
  // dailyStopLoss > 0: bloqueia novas entradas quando o PnL acumulado do run
  //   (= do dia, em modo chunked/dailyMetrics) cai abaixo de -dailyStopLoss.
  // lossStreakPauseCount > 0: após N eventos perdedores consecutivos, pula os
  //   próximos lossStreakPauseEvents eventos (cooldown de ~5min por evento).
  param dailyStopLoss = 0
  param lossStreakPauseCount = 0
  param lossStreakPauseEvents = 3

  onEventStart(event) {
    // Rastreio de resultado do evento anterior via delta de runState.totalPnl
    // (atualizado pelo runtime no finalize do evento anterior).
    if (runState.breakerInit != 1) {
      runState.breakerInit = 1
      runState.prevPnl = 0
      runState.lossStreak = 0
      runState.pauseLeft = 0
    }
    let pnlDelta = runState.totalPnl - runState.prevPnl
    if (pnlDelta < (0.0 - 0.000001)) {
      runState.lossStreak = runState.lossStreak + 1
    }
    if (pnlDelta > 0.000001) {
      runState.lossStreak = 0
    }
    runState.prevPnl = runState.totalPnl
    if (runState.pauseLeft > 0) {
      runState.pauseLeft = runState.pauseLeft - 1
    }
    if (params.lossStreakPauseCount > 0 && runState.lossStreak >= params.lossStreakPauseCount) {
      runState.pauseLeft = params.lossStreakPauseEvents
      runState.lossStreak = 0
    }
    state.entryBlocked = false
    if (params.dailyStopLoss > 0 && runState.totalPnl <= (0.0 - params.dailyStopLoss)) {
      state.entryBlocked = true
    }
    if (runState.pauseLeft > 0) {
      state.entryBlocked = true
    }

    state.entered = false
    state.closed = false
    state.reversed = false
    state.signedDistance = 0
    state.entryZ = 0
    state.entryMode = ""
    state.entryBudgetUsed = 0
    state.z = 0
    state.isAdverseMove = false
    state.obiOk = true
    state.budgetFactor = 1.0
    state.reverseBudget = 0
    state.oddsShockDone = false
    state.oddsVelBlocked = false
    state.oddsVelHit = false
    state.oddsVelSizeMul = 1.0
  }

  onTick(tick, event) {
    let secsLeft = time.secondsUntil(event.end, tick.ts)

    if (position.open) {
      if (!state.entered) {
        state.entered = true
      }

      let side = position.side
      let bid = book.bid(side, tick)

      state.signedDistance = tick.underlyingPrice - event.priceToBeat
      if (side == "DOWN") {
        state.signedDistance = event.priceToBeat - tick.underlyingPrice
      }

      // Danger exit contínuo: colchão normalizado z = dist / (sigma_ps * sqrt(tau))
      let dangerContOn = params.dangerContinuousEnabled == true || params.dangerContinuousEnabled == 1
      if (dangerContOn && !state.closed && !state.reversed && secsLeft >= params.dangerExitFloorSec && secsLeft <= params.dangerContinuousStartSec) {
        let sigmaLevelD = signals.volatility(samples, params.sigmaLookbackSecs)
        let sigmaPsD = sigmaLevelD / params.sigmaDivisor
        if (sigmaPsD > 0 && state.signedDistance > 0 && bid >= params.stopMinBid) {
          let zNow = state.signedDistance / (sigmaPsD * math.sqrt(secsLeft))
          if (zNow < params.dangerContinuousMinZ) {
            let dangerContOut = exit({ price: bid, reason: "danger_exit_continuous" })
            if (dangerContOut) {
              state.closed = dangerContOut.closed
              mark("exit", { reason: "danger_exit_continuous", price: bid, z: zNow })
            }
          }
        }
      }

      // Early-warning exit: ask do oposto reprecificando contra a posição
      let earlyWarnOn = params.earlyWarnEnabled == true || params.earlyWarnEnabled == 1
      if (earlyWarnOn && !state.closed && !state.reversed && secsLeft <= params.earlyWarnStartSec && secsLeft > params.earlyWarnEndSec && bid >= params.stopMinBid) {
        let ewOppSide = prices.oppositeSide(side)
        let ewOppAsk = book.ask(ewOppSide, tick)
        let ewOnlyLosing = params.earlyWarnOnlyIfLosing == true || params.earlyWarnOnlyIfLosing == 1
        let ewLosingOk = !ewOnlyLosing || state.signedDistance <= 0
        if (ewLosingOk && ewOppAsk > 0 && ewOppAsk >= params.earlyWarnOppAsk) {
          let ewOut = exit({ price: bid, reason: "early_warn_exit" })
          if (ewOut) {
            state.closed = ewOut.closed
            mark("exit", { reason: "early_warn_exit", price: bid, oppAsk: ewOppAsk, secsLeft: secsLeft })
          }
        }
      }

      // Cushion Decay: colchão físico sumiu (signedDistance <= floor) com bid ainda
      // salvável — EXIT antes do wipeout binário / late-flip tardio.
      let cushionOn = params.cushionDecayEnabled == true || params.cushionDecayEnabled == 1
      if (cushionOn && !state.closed && !state.reversed && secsLeft <= params.cushionDecayStartSec && secsLeft >= params.cushionDecayEndSec && bid >= params.stopMinBid) {
        let cdEntry = position.avgPrice
        let cdBidOk = params.cushionDecayMinBidRatio <= 0 || (cdEntry > 0 && bid >= (cdEntry * params.cushionDecayMinBidRatio))
        if (cdBidOk && state.signedDistance <= params.cushionDecayMinDist) {
          let cdOut = exit({ price: bid, reason: "cushion_decay_exit" })
          if (cdOut) {
            state.closed = cdOut.closed
            mark("exit", { reason: "cushion_decay_exit", price: bid, dist: state.signedDistance, entry: cdEntry, secsLeft: secsLeft })
          }
        }
      }

      // Book collapse: bid próprio << avgEntry (com spot ainda favorável opcional)
      let bookCollapseOn = params.bookCollapseEnabled == true || params.bookCollapseEnabled == 1
      if (bookCollapseOn && !state.closed && !state.reversed && secsLeft <= params.bookCollapseStartSec && secsLeft >= params.bookCollapseEndSec && bid >= params.stopMinBid) {
        let entryPx = position.avgPrice
        let requireWinning = params.bookCollapseRequireSpotWinning == true || params.bookCollapseRequireSpotWinning == 1
        let spotOk = !requireWinning || state.signedDistance > 0
        let ratioHit = entryPx > 0 && params.bookCollapseBidRatio > 0 && bid < (entryPx * params.bookCollapseBidRatio)
        let absHit = params.bookCollapseAbsBid > 0 && bid < params.bookCollapseAbsBid
        if (spotOk && (ratioHit || absHit)) {
          let bcOut = exit({ price: bid, reason: "book_collapse_exit" })
          if (bcOut) {
            state.closed = bcOut.closed
            mark("exit", { reason: "book_collapse_exit", price: bid, entry: entryPx, ratio: params.bookCollapseBidRatio, secsLeft: secsLeft })
          }
        }
      }

      // Odds shock: velocidade de reprecificação UP/DOWN (X-cross)
      // compiled-soa: sem reassignment de let locais — deltas calculados uma vez.
      let oddsShockOn = params.oddsShockEnabled == true || params.oddsShockEnabled == 1
      if (oddsShockOn && !state.oddsShockDone && !state.closed && !state.reversed && secsLeft <= params.oddsShockStartSec && secsLeft >= params.oddsShockEndSec && bid >= params.stopMinBid) {
        let osOnlyLosing = params.oddsShockOnlyIfLosing == true || params.oddsShockOnlyIfLosing == 1
        let osLosingOk = !osOnlyLosing || state.signedDistance <= 0
        state.osBidOk = true
        if (params.oddsShockMinBidRatio > 0 && position.avgPrice > 0 && bid < (position.avgPrice * params.oddsShockMinBidRatio)) {
          state.osBidOk = false
        }
        if (osLosingOk && state.osBidOk) {
          let osOppSide = prices.oppositeSide(side)
          let osUpAskNow = book.ask("UP", tick)
          let osDownAskNow = book.ask("DOWN", tick)
          let osUpAskPast = signals.upAskAgo(samples, params.oddsShockLookbackSec)
          let osDownAskPast = signals.downAskAgo(samples, params.oddsShockLookbackSec)
          let osDownRise = osDownAskNow - osDownAskPast
          let osUpRise = osUpAskNow - osUpAskPast
          let osUpFall = osUpAskPast - osUpAskNow
          let osDownFall = osDownAskPast - osDownAskNow
          let osPastOk = osDownAskPast > 0 && osUpAskPast > 0
          if (side == "DOWN") {
            let osOppAskNowDn = osUpAskNow
            let osOppDeltaDn = osUpRise
            let osOwnDeltaDn = osDownFall
            let osHitDn = osPastOk && osOppAskNowDn >= params.oddsShockMinOppAsk && (osOppDeltaDn >= params.oddsShockOppAskDelta || osOwnDeltaDn >= params.oddsShockOwnAskDelta)
            if (osHitDn) {
              let osReverseOnDn = params.oddsShockReverseEnabled == true || params.oddsShockReverseEnabled == 1
              if (osReverseOnDn && !state.reversed && osOppAskNowDn > 0 && osOppAskNowDn <= params.lateFlipReverseMaxAsk) {
                state.reverseBudget = params.entryBudget
                if (state.entryBudgetUsed > 0) {
                  state.reverseBudget = state.entryBudgetUsed
                }
                state.reverseBudget = state.reverseBudget * params.lateFlipReverseBudgetFactor
                let osFlippedDn = reverse(osOppSide, { price: osOppAskNowDn, exitPrice: bid, budget: state.reverseBudget, tick: tick, ignoreConsumed: true, reason: "odds_shock_reverse" })
                if (osFlippedDn) {
                  state.reversed = true
                  state.oddsShockDone = true
                  mark("reverse", { reason: "odds_shock_reverse", from: side, to: osOppSide, ask: osOppAskNowDn, oppDelta: osOppDeltaDn, ownDelta: osOwnDeltaDn, secsLeft: secsLeft })
                }
              }
              if (!state.oddsShockDone && !state.reversed) {
                if (params.oddsShockPartialPct > 0 && params.oddsShockPartialPct < 1) {
                  let osPartialDn = exit({ price: bid, pct: params.oddsShockPartialPct, reason: "odds_shock_partial" })
                  if (osPartialDn) {
                    state.oddsShockDone = true
                    state.closed = osPartialDn.closed
                    mark("exit", { reason: "odds_shock_partial", price: bid, pct: params.oddsShockPartialPct, oppDelta: osOppDeltaDn, ownDelta: osOwnDeltaDn, secsLeft: secsLeft })
                  }
                }
                if (!state.oddsShockDone) {
                  let osOutDn = exit({ price: bid, reason: "odds_shock_exit" })
                  if (osOutDn) {
                    state.oddsShockDone = true
                    state.closed = osOutDn.closed
                    mark("exit", { reason: "odds_shock_exit", price: bid, oppAsk: osOppAskNowDn, oppDelta: osOppDeltaDn, ownDelta: osOwnDeltaDn, secsLeft: secsLeft })
                  }
                }
              }
            }
          }
          if (side == "UP") {
            let osOppAskNowUp = osDownAskNow
            let osOppDeltaUp = osDownRise
            let osOwnDeltaUp = osUpFall
            let osHitUp = osPastOk && osOppAskNowUp >= params.oddsShockMinOppAsk && (osOppDeltaUp >= params.oddsShockOppAskDelta || osOwnDeltaUp >= params.oddsShockOwnAskDelta)
            if (osHitUp) {
              let osReverseOnUp = params.oddsShockReverseEnabled == true || params.oddsShockReverseEnabled == 1
              if (osReverseOnUp && !state.reversed && osOppAskNowUp > 0 && osOppAskNowUp <= params.lateFlipReverseMaxAsk) {
                state.reverseBudget = params.entryBudget
                if (state.entryBudgetUsed > 0) {
                  state.reverseBudget = state.entryBudgetUsed
                }
                state.reverseBudget = state.reverseBudget * params.lateFlipReverseBudgetFactor
                let osFlippedUp = reverse(osOppSide, { price: osOppAskNowUp, exitPrice: bid, budget: state.reverseBudget, tick: tick, ignoreConsumed: true, reason: "odds_shock_reverse" })
                if (osFlippedUp) {
                  state.reversed = true
                  state.oddsShockDone = true
                  mark("reverse", { reason: "odds_shock_reverse", from: side, to: osOppSide, ask: osOppAskNowUp, oppDelta: osOppDeltaUp, ownDelta: osOwnDeltaUp, secsLeft: secsLeft })
                }
              }
              if (!state.oddsShockDone && !state.reversed) {
                if (params.oddsShockPartialPct > 0 && params.oddsShockPartialPct < 1) {
                  let osPartialUp = exit({ price: bid, pct: params.oddsShockPartialPct, reason: "odds_shock_partial" })
                  if (osPartialUp) {
                    state.oddsShockDone = true
                    state.closed = osPartialUp.closed
                    mark("exit", { reason: "odds_shock_partial", price: bid, pct: params.oddsShockPartialPct, oppDelta: osOppDeltaUp, ownDelta: osOwnDeltaUp, secsLeft: secsLeft })
                  }
                }
                if (!state.oddsShockDone) {
                  let osOutUp = exit({ price: bid, reason: "odds_shock_exit" })
                  if (osOutUp) {
                    state.oddsShockDone = true
                    state.closed = osOutUp.closed
                    mark("exit", { reason: "odds_shock_exit", price: bid, oppAsk: osOppAskNowUp, oppDelta: osOppDeltaUp, ownDelta: osOwnDeltaUp, secsLeft: secsLeft })
                  }
                }
              }
            }
          }
        }
      }

      // Danger exit V7: gatilho vol-relativo no piso
      let dangerExitOn = params.dangerExitEnabled == true || params.dangerExitEnabled == 1
      if (dangerExitOn && !state.closed && !state.reversed && secsLeft >= params.dangerExitFloorSec && secsLeft < (params.dangerExitFloorSec + 1)) {
        let sigma = signals.volatility(samples, 5)
        if (math.abs(state.signedDistance) < (params.dangerExitK * sigma)) {
          let dangerOut = exit({ price: bid, reason: "danger_exit" })
          if (dangerOut) {
            state.closed = dangerOut.closed
            mark("exit", { reason: "danger_exit", price: bid, sigma: sigma })
          }
        }
      }

      // Late flip exit/reverse 8s -> piso 4s
      let lateFlipExitOn = params.lateFlipExitEnabled == true || params.lateFlipExitEnabled == 1
      if (!state.closed && lateFlipExitOn && secsLeft <= params.lateFlipExitSec && secsLeft >= params.lateFlipMinSec && state.signedDistance <= params.lateFlipExitCrossDist && bid >= params.stopMinBid && bid < params.lateFlipExitMaxBid) {
        let lateFlipReverseOn = params.lateFlipReverseEnabled == true || params.lateFlipReverseEnabled == 1
        if (lateFlipReverseOn && !state.reversed) {
          let oppSide = prices.oppositeSide(side)
          let oppAsk = book.ask(oppSide, tick)
          if (oppAsk >= params.lateFlipReverseMinAsk && oppAsk > 0 && oppAsk <= params.lateFlipReverseMaxAsk) {
            state.reverseBudget = params.entryBudget
            if (state.entryBudgetUsed > 0) {
              state.reverseBudget = state.entryBudgetUsed
            }
            state.reverseBudget = state.reverseBudget * params.lateFlipReverseBudgetFactor
            let flipped = reverse(oppSide, { price: oppAsk, exitPrice: bid, budget: state.reverseBudget, tick: tick, ignoreConsumed: true, reason: "late_flip_reverse" })
            if (flipped) {
              state.reversed = true
              mark("reverse", { reason: "late_flip_reverse", from: side, to: oppSide, ask: oppAsk })
            }
          }
        }
        if (!state.reversed) {
          let lateFlipped = exit({ price: bid, reason: "late_flip_exit" })
          if (lateFlipped) {
            state.closed = lateFlipped.closed
            mark("exit", { reason: "late_flip_exit", price: bid })
          }
        }
      }
    } else {
      if (!state.entered && !state.closed) {
        let btc = tick.underlyingPrice
        let ptb = event.priceToBeat
        let dist = math.abs(btc - ptb)
        let fav = market.sideFromPrice(btc, ptb)
        let ask = book.ask(fav, tick)
        let bid = book.bid(fav, tick)
        let spread = ask - bid

        // z-score físico compartilhado pelos dois modos de entrada
        let sigmaLevel = signals.volatility(samples, params.sigmaLookbackSecs)
        let sigmaPs = sigmaLevel / params.sigmaDivisor
        state.z = 0.0
        if (sigmaPs > 0 && secsLeft > 0) {
          state.z = dist / (sigmaPs * math.sqrt(secsLeft))
        }

        // Velocity guard compartilhado
        state.isAdverseMove = false
        let btcPast = signals.underlyingAgo(samples, params.velocityLookbackSecs)
        if (btcPast) {
          let spotChange = btc - btcPast
          if (fav == "UP" && spotChange < 0.0 - params.maxAdverseSpotChange) {
            state.isAdverseMove = true
          }
          if (fav == "DOWN" && spotChange > params.maxAdverseSpotChange) {
            state.isAdverseMove = true
          }
        }

        // Odds-velocity entry gate (book já virando / chop de ask)
        // Condicionais: mode 0 = qualquer vel; 1 = AND; 2 = OR (askMax/distMin ativos).
        // Ação: blockOnHit → bloqueia; senão sizeFactor < 1 → reduz orçamento.
        state.oddsVelBlocked = false
        state.oddsVelHit = false
        state.oddsVelSizeMul = 1.0
        state.oddsVelCondMatched = false
        let ovGateOn = params.oddsVelGateEnabled == true || params.oddsVelGateEnabled == 1
        if (ovGateOn) {
          let ovUpNow = book.ask("UP", tick)
          let ovDownNow = book.ask("DOWN", tick)
          let ovUpPast = signals.upAskAgo(samples, params.oddsVelLookbackSec)
          let ovDownPast = signals.downAskAgo(samples, params.oddsVelLookbackSec)
          if (ovUpPast > 0 && ovDownPast > 0 && ovUpNow > 0 && ovDownNow > 0) {
            if (fav == "UP") {
              let ovOppRiseUp = ovDownNow - ovDownPast
              let ovOwnFallUp = ovUpPast - ovUpNow
              if (ovOppRiseUp >= params.oddsVelMaxDelta || ovOwnFallUp >= params.oddsVelMaxDelta) {
                state.oddsVelHit = true
              }
            }
            if (fav == "DOWN") {
              let ovOppRiseDn = ovUpNow - ovUpPast
              let ovOwnFallDn = ovDownPast - ovDownNow
              if (ovOppRiseDn >= params.oddsVelMaxDelta || ovOwnFallDn >= params.oddsVelMaxDelta) {
                state.oddsVelHit = true
              }
            }
          }
          if (state.oddsVelHit) {
            if (params.oddsVelCondMode <= 0) {
              state.oddsVelCondMatched = true
            }
            if (params.oddsVelCondMode == 1) {
              let ovAskOk = params.oddsVelCondAskMax <= 0 || ask <= params.oddsVelCondAskMax
              let ovDistOk = params.oddsVelCondDistMin <= 0 || dist >= params.oddsVelCondDistMin
              let ovSecsOk = params.oddsVelCondMinSecs <= 0 || secsLeft >= params.oddsVelCondMinSecs
              if (ovAskOk && ovDistOk && ovSecsOk) {
                state.oddsVelCondMatched = true
              }
            }
            if (params.oddsVelCondMode == 2) {
              let ovAskHit = params.oddsVelCondAskMax > 0 && ask <= params.oddsVelCondAskMax
              let ovDistHit = params.oddsVelCondDistMin > 0 && dist >= params.oddsVelCondDistMin
              if (ovAskHit || ovDistHit) {
                state.oddsVelCondMatched = true
              }
            }
          }
          if (state.oddsVelCondMatched) {
            let ovBlockOn = params.oddsVelBlockOnHit == true || params.oddsVelBlockOnHit == 1
            if (ovBlockOn) {
              state.oddsVelBlocked = true
            }
            if (ovBlockOn == false && params.oddsVelSizeFactor > 0 && params.oddsVelSizeFactor < 1) {
              state.oddsVelSizeMul = params.oddsVelSizeFactor
            }
          }
        }

        // Equity corrente (compartilhada por core e scoop)
        let equity = math.max(0, params.walletSize + runState.totalPnl)
        state.equityRawBudget = params.entryBudget
        let equityScaleOn = params.equityScaleEnabled == true || params.equityScaleEnabled == 1
        if (equityScaleOn) {
          state.equityRawBudget = math.max(params.entryBudget, equity * params.equityScalePct)
        }

        // ===== Modo 1: núcleo TFC (envelope V7) =====
        state.tierZOk = true
        if (params.tierMinZ > 0 && ask >= params.tierAskThreshold && state.z < params.tierMinZ) {
          state.tierZOk = false
        }
        state.tierDistOk = true
        if (params.tierMinDistAbs > 0 && ask >= params.tierAskThreshold && dist < params.tierMinDistAbs) {
          state.tierDistOk = false
        }
        if (state.tierZOk && state.tierDistOk && !state.entryBlocked && !state.isAdverseMove && !state.oddsVelBlocked && state.z >= params.minEntryZ && secsLeft >= params.minSecondsLeft && secsLeft < params.maxSecondsLeft && dist < params.maxDistAbs && ask >= params.minAsk && ask <= params.maxAsk && spread <= params.maxSpread) {
          let upAsk = book.ask("UP", tick)
          let downAsk = book.ask("DOWN", tick)
          let oddsSum = upAsk + downAsk
          if (oddsSum >= params.minOddsSum && oddsSum <= params.maxOddsSum) {
            state.obiOk = true
            if (params.minObi > (0.0 - 1.0)) {
              let obi = model.orderBookImbalance(fav, tick, params.obiLevels)
              if (obi < params.minObi) {
                state.obiOk = false
              }
            }
            if (state.obiOk) {
              // Sigma sizing
              state.budgetFactor = 1.0
              let sizingOn = params.sigmaSizingEnabled == true || params.sigmaSizingEnabled == 1
              if (sizingOn) {
                state.budgetFactor = params.wZ2
                if (state.z < params.zT1) {
                  state.budgetFactor = params.wZ0
                }
                if (state.z >= params.zT1 && state.z < params.zT2) {
                  state.budgetFactor = params.wZ1
                }
                if (state.z >= params.zT3 && state.z < params.zT4) {
                  state.budgetFactor = params.wZ3
                }
                if (state.z >= params.zT4) {
                  state.budgetFactor = params.wZ4
                }
              }
              if (ask >= params.tierAskThreshold) {
                state.budgetFactor = state.budgetFactor * params.tierAskBudgetFactor
              }
              state.lossCap = 999999.0
              if (params.maxLossUsd > 0) {
                state.lossCap = params.maxLossUsd
              }
              let budget = math.min(state.equityRawBudget * state.budgetFactor * state.oddsVelSizeMul, params.maxEntryBudget, equity, state.lossCap)
              let maxPrice = ask + params.entrySlippageMax
              let bought = enter(fav, { price: ask, maxPrice: maxPrice, budget: budget, minShares: params.minShares, minLiquidityRatio: params.minLiquidityRatio, tick: tick, reason: "midas_core_entry" })
              if (bought) {
                state.entered = true
                state.entryZ = state.z
                state.entryMode = "core"
                state.entryBudgetUsed = budget
                mark("midas_entry", { mode: "core", side: fav, ask: ask, dist: dist, z: state.z, budgetFactor: state.budgetFactor, oddsVelSizeMul: state.oddsVelSizeMul, secsLeft: secsLeft })
              }
            }
          }
        }

        // ===== Modo 2: scoop — favorito barato com z alto =====
        let scoopOn = params.scoopEnabled == true || params.scoopEnabled == 1
        if (scoopOn && !state.entryBlocked && !state.entered && !state.isAdverseMove && !state.oddsVelBlocked && secsLeft >= params.scoopMinSecondsLeft && secsLeft < params.scoopMaxSecondsLeft && dist < params.scoopMaxDistAbs && ask >= params.scoopMinAsk && ask < params.scoopMaxAsk && spread <= params.scoopMaxSpread && state.z >= params.scoopMinZ) {
          let scoopUpAsk = book.ask("UP", tick)
          let scoopDownAsk = book.ask("DOWN", tick)
          let scoopOddsSum = scoopUpAsk + scoopDownAsk
          if (scoopOddsSum >= params.scoopMinOddsSum && scoopOddsSum <= params.scoopMaxOddsSum) {
          state.lossCap = 999999.0
          if (params.maxLossUsd > 0) {
            state.lossCap = params.maxLossUsd
          }
          let scoopBudget = math.min(state.equityRawBudget * params.scoopBudgetFactor * state.oddsVelSizeMul, params.maxEntryBudget, equity, state.lossCap)
          let scoopMaxPrice = ask + params.entrySlippageMax
          let scooped = enter(fav, { price: ask, maxPrice: scoopMaxPrice, budget: scoopBudget, minShares: params.minShares, minLiquidityRatio: params.minLiquidityRatio, tick: tick, reason: "midas_scoop_entry" })
          if (scooped) {
            state.entered = true
            state.entryZ = state.z
            state.entryMode = "scoop"
            state.entryBudgetUsed = scoopBudget
            mark("midas_entry", { mode: "scoop", side: fav, ask: ask, dist: dist, z: state.z, secsLeft: secsLeft })
          }
          }
        }
      }
    }
  }

  onEventEnd(event) {
  }
}
