    "exitSecsFloor": { "type": "number", "minimum": 0 },
    "snipeMinDelta": { "type": "number", "minimum": 0 },
    "lockMinAsk": { "type": "number", "minimum": 0, "maximum": 1 },
    "lockMaxAsk": { "type": "number", "minimum": 0, "maximum": 1 },
    "snipeMaxAsk": { "type": "number", "minimum": 0, "maximum": 1 },
    "enableExits": { "type": "number", "enum": [0, 1] },
    "exitCushion": { "type": "number", "minimum": 0 },
    "takeProfitTicks": { "type": "number", "minimum": 0 },
    "adverseVelAbs": { "type": "number", "minimum": 0 },
    "oppositeAskExit": { "type": "number", "minimum": 0, "maximum": 1 },
    "cutBeforeSettleSecs": { "type": "number", "minimum": 0 }
