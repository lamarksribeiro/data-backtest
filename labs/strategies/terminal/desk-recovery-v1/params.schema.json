{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "walletSize": { "type": "number", "minimum": 1 },
    "entryBudget": { "type": "number", "minimum": 1 },
    "minShares": { "type": "number", "minimum": 1 },
    "entrySlippageMax": { "type": "number", "minimum": 0 },
    "minLiquidityRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "minSecondsLeft": { "type": "number", "minimum": 1 },
    "maxSecondsLeft": { "type": "number", "minimum": 1 },
    "minCushion": { "type": "number", "minimum": 0 },
    "maxAsk": { "type": "number", "minimum": 0, "maximum": 1 },
    "convictionCushion": { "type": "number", "minimum": 0 },
    "convictionMaxAsk": { "type": "number", "minimum": 0, "maximum": 1 },
    "minVelAbs": { "type": "number", "minimum": 0 },
    "velLookbackSecs": { "type": "number", "minimum": 1 },
    "requireVelAligned": { "type": "number", "enum": [0, 1] },
    "enableLock": { "type": "number", "enum": [0, 1] },
    "enableSnipe": { "type": "number", "enum": [0, 1] },
    "enableMisprice": { "type": "number", "enum": [0, 1] },
