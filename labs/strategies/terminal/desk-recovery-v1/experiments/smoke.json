{
  "name": "desk-recovery-smoke",
  "strategyId": "desk-recovery-v1",
  "strategyFamily": "terminal",
  "dataset": "backtest_ticks",
  "underlying": "BTC",
  "interval": "5m",
  "bookDepth": 25,
  "from": "2026-06-01",
  "to": "2026-06-07",
  "engine": "soa",
  "glsExecution": "compiled-soa",
  "fastRun": true,
  "dailyMetrics": true,
  "defaults": "../defaults.json",
  "searchSpace": {
    "variants": [
      {
        "id": "recovery-live",
        "params": {
          "enableMisprice": 1,
          "enableLock": 1,
          "enableSnipe": 1,
          "enableExits": 1,
          "minCushion": 40,
          "maxAsk": 0.55,
          "entryBudget": 2.2
        }
      },
      {
        "id": "recovery-hold",
        "params": {
          "enableMisprice": 1,
          "enableLock": 1,
          "enableSnipe": 1,
          "enableExits": 0,
          "minCushion": 40,
          "maxAsk": 0.55,
          "entryBudget": 2.2
        }
      },
      {
        "id": "soft-misprice",
        "params": {
          "enableMisprice": 1,
          "enableLock": 0,
          "enableSnipe": 0,
          "enableExits": 1,
          "minCushion": 25,
          "maxAsk": 0.62,
          "convictionCushion": 40,
          "convictionMaxAsk": 0.72,
          "entryBudget": 2.2
        }
      },
      {
        "id": "lock-only",
        "params": {
          "enableMisprice": 0,
          "enableLock": 1,
          "enableSnipe": 0,
          "enableExits": 0,
          "snipeMinDelta": 40,
          "lockMinAsk": 0.85,
          "lockMaxAsk": 0.96,
          "entryBudget": 2.2
        }
      },
      {
        "id": "snipe-only",
        "params": {
          "enableMisprice": 0,
          "enableLock": 0,
          "enableSnipe": 1,
          "enableExits": 0,
          "snipeMinDelta": 40,
          "snipeMaxAsk": 0.25,
          "entryBudget": 2.2
        }
      }
    ]
  }
}
