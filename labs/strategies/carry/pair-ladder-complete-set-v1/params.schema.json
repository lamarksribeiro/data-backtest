{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "walletSize": { "type": "number", "minimum": 1 },
    "mode": { "type": "string", "enum": ["clip_ladder", "micro_spray"] },
    "openShares": { "type": "integer", "minimum": 1 },
    "clipShares": { "type": "integer", "minimum": 1 },
    "openMinAsk": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
    "openMaxAsk": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
    "maxSecToOpen": { "type": "number", "minimum": 1 },
    "maxSecToHedge": { "type": "number", "minimum": 1 },
    "seedHedgeSameTick": { "type": "boolean" },
    "minSecondsLeftToEnter": { "type": "number", "minimum": 0 },
    "stopAvgSum": { "type": "number", "minimum": 0.5, "maximum": 1.2 },
    "stopMinBalance": { "type": "number", "minimum": 0, "maximum": 1 },
    "blockAvgSum": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
    "maxResidualShares": { "type": "number", "minimum": 0 },
    "pairSnapMax": { "type": "number", "minimum": 0.5, "maximum": 1.2 },
    "rebalanceSlackCents": { "type": "number", "minimum": 0 },
    "lateStartSec": { "type": "number", "minimum": 0, "maximum": 300 },
    "lateMaxAsk": { "type": "number", "minimum": 0.01, "maximum": 0.5 },
    "lateUltraAsk": { "type": "number", "minimum": 0.01, "maximum": 0.5 },
    "lateClipShares": { "type": "integer", "minimum": 1 },
    "lateUltraClipShares": { "type": "integer", "minimum": 1 },
    "lateOnlyImprove": { "type": "boolean" },
    "lateRequireResidual": { "type": "boolean" },
    "lateOrphanAllowed": { "type": "boolean" },
    "rebalanceMaxAsk": { "type": "number", "minimum": 0.05, "maximum": 0.99 },
    "rebalanceCushionAsk": { "type": "number", "minimum": 0.05, "maximum": 0.99 },
    "rebalanceMinResidual": { "type": "number", "minimum": 0 },
    "chaseMaxAsk": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
    "chaseOverweightMaxAsk": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
    "refuseAvgSum": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
    "scaleOnlyTowardLock": { "type": "boolean" },
    "forbidOverweight": { "type": "boolean" },
    "softLockAllowVacuum": { "type": "boolean" },
    "softLockAllowBuild": { "type": "boolean" },
    "hedgeShares": { "type": "integer", "minimum": 1 },
    "fillMode": { "type": "string", "enum": ["taker", "mid", "optimistic_maker", "resting_maker"] },
    "makerFillEpsilon": { "type": "number", "minimum": 0, "maximum": 0.1 },
    "makerTimeoutSec": { "type": "number", "minimum": 1 },
    "buildOnlyImprove": { "type": "boolean" },
    "buildMaxAvgSum": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
    "legChoice": { "type": "string", "enum": ["min_avg_sum", "chase_momo"] },
    "momoLookbackSec": { "type": "number", "minimum": 1 },
    "momoMinRise": { "type": "number", "minimum": 0.005, "maximum": 0.2 },
    "momoMinAsk": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
    "momoMaxAsk": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
    "maxEventNotional": { "type": "number", "minimum": 1 },
    "maxSharesPerSide": { "type": "integer", "minimum": 1 },
    "maxFillsPerEvent": { "type": "integer", "minimum": 1 },
    "applyPolymarketFees": { "type": "boolean" },
    "polymarketFeeCategory": { "type": "string" }
  }
}
