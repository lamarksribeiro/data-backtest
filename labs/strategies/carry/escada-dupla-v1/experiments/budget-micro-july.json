{
  "name": "escada-dupla-budget-micro-july",
  "strategyId": "escada-dupla-v1",
  "strategyFamily": "carry",
  "description": "Reteste de budget sob microestrutura: optimistic vs resting_maker × slip 0/1¢ × sizeScale 0.25/0.5/1. Fees crypto + spread 1¢.",
  "dataset": "backtest_ticks",
  "underlying": "BTC",
  "interval": "5m",
  "bookDepth": 25,
  "from": "2026-07-01",
  "to": "2026-07-22",
  "engine": "soa",
  "glsExecution": "compiled-soa",
  "fastRun": true,
  "dailyMetrics": true,
  "variantWorkers": 4,
  "defaults": "../defaults.json",
  "feeOptions": { "category": "crypto" },
  "searchSpace": {
    "grid": {
      "ladderProfile": ["ascent_hedge"],
      "rearmMode": ["off"],
      "sideMultiplier": [1],
      "maxSubLevels": [8],
      "maxDescLevels": [4],
      "maxPairAvgSumCents": [98],
      "liquidityMode": ["auto"],
      "executionMode": ["optimistic_maker", "resting_maker"],
      "spreadCents": [1],
      "slippageCents": [0, 1],
      "equalizeExtraSlipCents": [0],
      "sizeScale": [0.25, 0.5, 1.0]
    }
  },
  "metrics": ["totalPnl", "entries", "winRate", "profitFactor", "maxDrawdown"]
}
