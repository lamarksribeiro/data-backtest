{
  "name": "escada-dupla-budget-min-july",
  "strategyId": "escada-dupla-v1",
  "strategyFamily": "carry",
  "description": "Varre sizeScale (budget proporcional) no holdout julho para achar o mínimo ainda altamente lucrativo. Campeão=1.0 (~$80/evento). Critério alto: PF≥1.7, WR≥65%, dias+≥95%.",
  "dataset": "backtest_ticks",
  "underlying": "BTC",
  "interval": "5m",
  "bookDepth": 25,
  "from": "2026-07-01",
  "to": "2026-07-22",
  "engine": "soa",
  "glsExecution": "compiled-soa",
  "fastRun": true,
  "dailyMetrics": true,
  "variantWorkers": 4,
  "defaults": "../defaults.json",
  "feeOptions": { "category": "crypto" },
  "searchSpace": {
    "grid": {
      "ladderProfile": ["ascent_hedge"],
      "rearmMode": ["off"],
      "sideMultiplier": [1],
      "maxSubLevels": [8],
      "maxDescLevels": [4],
      "maxPairAvgSumCents": [98],
      "spreadCents": [1],
      "executionMode": ["optimistic_maker"],
      "liquidityMode": ["auto"],
      "sizeScale": [0.125, 0.1875, 0.25, 0.3125, 0.375, 0.5, 0.625, 0.75, 1.0]
    }
  },
  "metrics": ["totalPnl", "entries", "winRate", "profitFactor", "maxDrawdown"]
}
