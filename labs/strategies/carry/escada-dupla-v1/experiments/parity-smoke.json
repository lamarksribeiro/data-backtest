{
  "name": "escada-dupla-parity-smoke",
  "strategyId": "escada-dupla-v1",
  "strategyFamily": "carry",
  "dataset": "backtest_ticks",
  "underlying": "BTC",
  "interval": "5m",
  "bookDepth": 25,
  "from": "2026-07-20",
  "to": "2026-07-21",
  "engine": "soa",
  "glsExecution": "compiled-soa",
  "fastRun": true,
  "dailyMetrics": true,
  "variantWorkers": 2,
  "defaults": "../defaults.json",
  "feeOptions": { "category": "crypto" },
  "searchSpace": {
    "grid": {
      "sideMultiplier": [1, 2],
      "executionMode": ["optimistic_maker"],
      "liquidityMode": ["auto"],
      "spreadCents": [0, 1],
      "slippageCents": [0]
    }
  },
  "metrics": ["totalPnl", "entries", "winRate", "profitFactor", "maxDrawdown"]
}
