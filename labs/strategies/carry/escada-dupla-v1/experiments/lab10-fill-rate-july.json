{
  "name": "escada-dupla-lab10-fill-rate-july",
  "strategyId": "escada-dupla-v1",
  "strategyFamily": "carry",
  "description": "Lab 10: stress de fill-rate do hedge maker (fila). Base = touch realistic v5 (capped1+slip1). Varre makerFillProb e miss policy rest/skip.",
  "dataset": "backtest_ticks",
  "underlying": "BTC",
  "interval": "5m",
  "bookDepth": 25,
  "from": "2026-07-01",
  "to": "2026-07-22",
  "engine": "soa",
  "glsExecution": "compiled-soa",
  "fastRun": true,
  "dailyMetrics": true,
  "variantWorkers": 4,
  "defaults": "../defaults.json",
  "feeOptions": { "category": "crypto" },
  "searchSpace": {
    "grid": {
      "ladderProfile": ["ascent_hedge"],
      "rearmMode": ["off"],
      "sideMultiplier": [1],
      "maxSubLevels": [8],
      "maxDescLevels": [4],
      "maxPairAvgSumCents": [98],
      "liquidityMode": ["auto"],
      "executionMode": ["touch_maker"],
      "makerPostMode": ["limit"],
      "throughFillOnTrigger": [true],
      "rearmOnMakerCancel": [true],
      "takerPriceMode": ["capped"],
      "takerMaxExtraCents": [1],
      "spreadCents": [1],
      "slippageCents": [1],
      "equalizeExtraSlipCents": [0],
      "makerFillEpsilon": [0.01],
      "makerTimeoutSec": [30],
      "sizeScale": [1],
      "makerMissPolicy": ["rest", "skip"],
      "makerFillProb": [1.0, 0.85, 0.7, 0.55, 0.4, 0.25]
    }
  },
  "metrics": ["totalPnl", "entries", "winRate", "profitFactor", "maxDrawdown"]
}
