{
  "name": "escada-dupla-taker-limit-july-frozen",
  "strategyId": "escada-dupla-v1",
  "strategyFamily": "carry",
  "description": "Etapa 1 (validação): mesmas configs honestas do taker-limit-may-june rodadas em julho SEM retunar. Regra pré-declarada: só a config campeã de mai-jun é julgada aqui (gate PF >= 1,2 e PnL > 0); demais variantes são contexto. Inclui 23-25/jul (dias nunca usados em seleção).",
  "dataset": "backtest_ticks",
  "underlying": "BTC",
  "interval": "5m",
  "bookDepth": 25,
  "from": "2026-07-01",
  "to": "2026-07-25",
  "engine": "soa",
  "glsExecution": "compiled-soa",
  "fastRun": true,
  "dailyMetrics": true,
  "variantWorkers": 4,
  "defaults": "../defaults.json",
