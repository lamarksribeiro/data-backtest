{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "walletSize": { "type": "number", "minimum": 1 },
    "sizeScale": { "type": "number", "minimum": 0.05, "maximum": 5 },
    "subLevels": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          {
            "type": "object",
            "properties": {
              "preco": { "type": "number" },
              "shares": { "type": "number" }
            }
          }
        ]
      }
    },
    "descLevels": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          {
            "type": "object",
            "properties": {
              "preco": { "type": "number" },
              "shares": { "type": "number" }
            }
          }
        ]
      }
    },
    "mult": {
      "type": "array",
      "items": { "type": "number", "minimum": 0.1 },
      "minItems": 1
    },
    "multDesc": {
      "type": "array",
      "items": { "type": "number", "minimum": 0.1 }
    },
    "multDescAtivo": { "type": "boolean" },
    "contagio": { "type": "string", "enum": ["off", "piso", "lado", "global"] },
    "contagioMin": { "type": "number", "minimum": 1 },
    "equalizar": { "type": "boolean" },
    "eqPreco": { "type": "number", "minimum": 0.01, "maximum": 0.2 },
    "eqEncerra": { "type": "boolean" },
    "equalizaIgnoraTeto": { "type": "boolean" },
    "eqExigeLucro": { "type": "boolean" },
    "eqLucroMinUsd": { "type": "number" },
    "eqLimiteAtivo": { "type": "boolean" },
    "eqLimiteArmaC": { "type": "number", "minimum": 1, "maximum": 50 },
    "eqLimiteCancelaC": { "type": "number", "minimum": 5, "maximum": 90 },
    "eqLimiteReposta": { "type": "boolean" },
    "eqLimiteResizeSh": { "type": "number", "minimum": 0 },
    "eqMakerAtivo": { "type": "boolean" },
    "eqMakerFolgaC": { "type": "number", "minimum": 0, "maximum": 10 },
    "geracaoAtiva": { "type": "boolean" },
    "viradaQualquerIdx": { "type": "boolean" },
    "viradaSoAtras": { "type": "boolean" },
    "viradaSoAtrasVirada": { "type": "integer", "minimum": 1 },
    "intervaloComprasSeg": { "type": "number", "minimum": 0 },
    "esperaAtiva": { "type": "boolean" },
    "esperaLimiteC": { "type": "number", "minimum": 50, "maximum": 99 },
    "esperaGatilhoC": { "type": "number", "minimum": 1, "maximum": 90 },
    "travaAtiva": { "type": "boolean" },
    "travaSomaC": { "type": "number", "minimum": 50, "maximum": 200 },
    "travaTolSh": { "type": "number", "minimum": 0 },
    "travaMinSh": { "type": "number", "minimum": 0 },
    "travaExigeLucro": { "type": "boolean" },
    "travaLucroMinUsd": { "type": "number" },
    "extratravaAtiva": { "type": "boolean" },
    "extratravaDescontoC": { "type": "number", "minimum": 0 },
    "extratravaMinUsd": { "type": "number", "minimum": 0 },
    "pausaLiderAtiva": { "type": "boolean" },
    "pausaLiderFolga": { "type": "number", "minimum": 0 },
    "tetoInvestAtivo": { "type": "boolean" },
    "tetoInvestFolga": { "type": "number", "minimum": 0 },
    "tetoDescAtivo": { "type": "boolean" },
    "multCalcAtivo": { "type": "boolean" },
    "multCalcVirada": { "type": "integer", "minimum": 1 },
    "multCalcFator": { "type": "number", "minimum": 0.1 },
    "pisoAtivo": { "type": "boolean" },
    "pisoViradas": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "pisoMargem": { "type": "number", "minimum": 0, "maximum": 2 },
    "maxViradasAtivo": { "type": "boolean" },
    "maxViradas": { "type": "integer", "minimum": 1 },
    "descModo": { "type": "string", "enum": ["comprar", "gatilho", "congela"] },
    "descVirada": { "type": "integer", "minimum": 1 },
    "descSoAtras": { "type": "boolean" },
    "eqstopAtivo": { "type": "boolean" },
    "eqstopVirada": { "type": "integer", "minimum": 1 },
    "eqstopGatilhoC": { "type": "number", "minimum": 1 },
    "forceEqFimAtivo": { "type": "boolean" },
    "forceEqFimSeg": { "type": "number", "minimum": 0 },
    "forceEqNoFreeze": { "type": "boolean" },
    "bloco27Ativo": { "type": "boolean" },
    "sub35Ativo": { "type": "boolean" },
    "extraAtiva": { "type": "boolean" },
    "fokAtivo": { "type": "boolean" },
    "fokPrecoTeto": { "type": "number", "minimum": 0.5, "maximum": 0.99 },
    "slippageCompra": { "type": "number", "minimum": 0, "maximum": 0.2 },
    "filterLo": { "type": "number", "minimum": 0, "maximum": 1 },
    "filterHi": { "type": "number", "minimum": 0, "maximum": 1 },
    "antiGlitch": { "type": "boolean" },
    "somaMinValida": { "type": "number" },
    "somaMaxValida": { "type": "number" },
    "minSecondsLeftToStart": { "type": "number", "minimum": 0 },
    "maxSecondsLeftToStart": { "type": "number", "minimum": 0 },
    "maxEventNotional": { "type": "number", "minimum": 5 },
    "tetoSharesOrdem": { "type": "number", "minimum": 0 },
    "makerFillEpsilon": { "type": "number", "minimum": 0 },
    "makerTimeoutSec": { "type": "number", "minimum": 1 },
    "takerMaxExtraCents": { "type": "number", "minimum": 0, "maximum": 20 },
    "takerMissPolicy": { "type": "string", "enum": ["rearm", "skip"] },
    "takerLatencyTicks": { "type": "integer", "minimum": 0, "maximum": 10 },
    "takerPriceMode": {
      "type": "string",
      "enum": ["taker_limit", "walk", "formula", "capped", "auto"]
    },
    "executionMode": { "type": "string", "enum": ["honest", "optimistic"] },
    "applyPolymarketFees": { "type": "boolean" },
    "polymarketFeeCategory": {
      "type": "string",
      "enum": ["crypto", "sports", "politics", "other"]
    }
  }
}
