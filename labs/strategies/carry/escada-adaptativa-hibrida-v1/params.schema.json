{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "walletSize": { "type": "number", "minimum": 1 },
    "riskPerEventPct": { "type": "number", "minimum": 0.0001, "maximum": 0.25 },
    "minShares": { "type": "number", "exclusiveMinimum": 0 },
    "tickSize": { "type": "number", "minimum": 0.0001, "maximum": 0.1 },
    "maxGrossExposurePct": { "type": "number", "minimum": 0.0001, "maximum": 1 },
    "maxCycles": { "type": "integer", "minimum": 1, "maximum": 10 },
    "entryWindowStartSec": { "type": "number", "minimum": 0, "maximum": 300 },
    "entryWindowEndSec": { "type": "number", "minimum": 0, "maximum": 300 },
    "hedgeCutoffSec": { "type": "number", "minimum": 0, "maximum": 300 },
    "minEdge": { "type": "number", "minimum": 0, "maximum": 0.5 },
    "cancelEdge": { "type": "number", "minimum": -0.5, "maximum": 0.5 },
    "minDirectionalProbability": { "type": "number", "minimum": 0.5, "maximum": 0.999 },
    "maxSpread": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.99 },
    "cancelSpread": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.99 },
    "rungEdgeStep": { "type": "number", "minimum": 0, "maximum": 0.25 },
    "hedgeMinWorstImprovementUsd": { "type": "number", "minimum": 0 },
    "hedgeMinProtectedProfitUsd": { "type": "number", "minimum": 0 },
    "makerTimeoutSec": { "type": "number", "minimum": 1, "maximum": 120 },
    "makerFillMode": { "type": "string", "enum": ["strict_cross", "adverse_entry_touch"] },
    "cancelLatencyTicks": { "type": "integer", "minimum": 0, "maximum": 10 },
    "takerLatencyTicks": { "type": "integer", "minimum": 0, "maximum": 10 },
    "requireQuality": { "type": "boolean" },
    "minCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "minTicksBeforeEntry": { "type": "integer", "minimum": 1 },
    "shockSigma": { "type": "number", "minimum": 0.25, "maximum": 10 },
    "minSigma": { "type": "number", "exclusiveMinimum": 0 },
    "sigmaMultiplier": { "type": "number", "minimum": 0.1, "maximum": 5 },
    "modelWeight": { "type": "number", "minimum": 0, "maximum": 1 },
    "driftWeight": { "type": "number", "minimum": -3, "maximum": 3 },
    "driftClampSigma": { "type": "number", "minimum": 0, "maximum": 4 },
    "accelerationWeight": { "type": "number", "minimum": -4, "maximum": 4 },
    "bookImbalanceWeight": { "type": "number", "minimum": -3, "maximum": 3 },
    "momentumSec": { "type": "number", "minimum": 1, "maximum": 90 },
    "slowMomentumSec": { "type": "number", "minimum": 1, "maximum": 180 },
    "slowMomentumWeight": { "type": "number", "minimum": -3, "maximum": 3 },
    "volLookbackSec": { "type": "number", "minimum": 5, "maximum": 180 },
    "applyPolymarketFees": { "type": "boolean" },
    "polymarketFeeCategory": { "type": "string", "enum": ["crypto"] },
    "polymarketFeeRate": { "type": "number", "minimum": 0 }
  }
}
